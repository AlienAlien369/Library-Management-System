# Copy this file to .env for local development.
# On Render, set these as real Environment Variables in the service's dashboard instead of committing them.

# MongoDB connection string (e.g. from MongoDB Atlas)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster-url>/<database>?retryWrites=true&w=majority

# Any long random string, used to sign JWTs
JWT_SECRET=replace_with_a_long_random_string

# Comma-separated list of allowed frontend origins (your Vercel URL(s))
CLIENT_ORIGIN=https://your-app.vercel.app

# Port to run the server on (Render sets this automatically)
PORT=5000
